# พอร์ตฝั่งเครื่องที่ใช้เปิดระบบ สามารถเปลี่ยนได้หากชนกับโปรเจกต์อื่น
FRONTEND_PORT=5174
BACKEND_PORT=4001
MYSQL_PORT=3308
PHPMYADMIN_PORT=8081

# ค่าความปลอดภัยและการเชื่อมต่อฐานข้อมูลสำหรับการพัฒนา
MYSQL_ROOT_PASSWORD=finalp4root
JWT_SECRET=finalp4-docker-development-secret
GOOGLE_CLIENT_ID=ใส่-Client-ID-จาก-Google-Cloud

# โหมดทดสอบการลงเวลา: 1 นาทีคิดเป็น 50 บาท และใช้พิกัดร้านจำลอง
ATTENDANCE_TEST_MODE=true
TEST_MINUTE_WAGE=50
WORK_START_TIME=09:00
WORK_END_TIME=18:00
WORK_GRACE_MINUTES=0
